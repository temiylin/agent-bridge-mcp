{
  "name": "agent-bridge-mcp",
  "version": "1.0.0",
  "description": "General local MCP server for task dispatch and result reading",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agent-bridge-mcp": "./dist/index.js",
    "agent-bridge-worker": "./dist/worker.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js dist/worker.js",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "test": "AGENT_BRIDGE_ROOT=/tmp/agent-bridge-test tsx test/test-runner.ts",
    "test:worker": "AGENT_BRIDGE_ROOT=/tmp/agent-bridge-worker-test tsx test/worker-test.ts",
    "test:e2e-codex": "tsx test/e2e-codex.ts",
    "test:e2e-codex-write": "tsx test/e2e-codex-write.ts"
  },
  "keywords": [
    "mcp",
    "agent",
    "bridge",
    "modelcontextprotocol",
    "stdio"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
