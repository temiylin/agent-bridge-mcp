{
  "name": "agent-bridge-mcp",
  "version": "1.0.0",
  "description": "General local MCP server for task dispatch and result reading",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agent-bridge-mcp": "./dist/index.js",
    "agent-bridge-worker": "./dist/worker.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "setup": "node scripts/auto-setup.mjs",
    "auto-setup": "node scripts/auto-setup.mjs",
    "url": "node scripts/device-url.mjs",
    "info": "node scripts/device-url.mjs",
    "dashboard": "node scripts/open-dashboard.mjs",
    "ui": "node scripts/open-dashboard.mjs",
    "agents:ui": "node scripts/agent-admin.mjs",
    "build": "tsc && chmod +x dist/index.js dist/worker.js",
    "start": "node dist/index.js",
    "serve": "node dist/index.js --http",
    "serve:mcp": "node dist/index.js --http --port 38080",
    "bridge:chatgpt": "node scripts/start-chatgpt-bridge.mjs",
    "connect": "node dist/index.js --connect",
    "pack:plugin": "cd plugin-package && zip -r ../agent-bridge-plugin.zip .",
    "worker": "node dist/worker.js",
    "test": "node scripts/run-env.mjs AGENT_BRIDGE_ROOT=/tmp/agent-bridge-test -- tsx test/test-runner.ts",
    "test:http": "node scripts/run-env.mjs AGENT_BRIDGE_ROOT=/tmp/agent-bridge-http-test -- tsx test/http-server-test.ts",
    "test:worker": "node scripts/run-env.mjs AGENT_BRIDGE_ROOT=/tmp/agent-bridge-worker-test AGENT_BRIDGE_NOTIFY=0 -- tsx test/worker-test.ts",
    "test:ops": "node scripts/run-env.mjs AGENT_BRIDGE_ROOT=/tmp/agent-bridge-ops-test -- tsx test/ops-test.ts",
    "test:repo-status": "node scripts/run-env.mjs AGENT_BRIDGE_ROOT=/tmp/agent-bridge-repo-status-test -- tsx test/repo-status-test.ts",
    "test:project-inspection": "tsc && node test/project-inspection-test.mjs && node test/repo-status-readonly-test.mjs",
    "test:worker-alive": "node scripts/run-env.mjs AGENT_BRIDGE_ROOT=/tmp/agent-bridge-worker-alive-test -- tsx test/worker-alive-test.ts",
    "test:list-tasks": "node scripts/run-env.mjs AGENT_BRIDGE_ROOT=/tmp/agent-bridge-list-tasks-test -- tsx test/list-tasks-test.ts",
    "test:agent-registry": "node scripts/run-env.mjs AGENT_BRIDGE_ROOT=/tmp/agent-bridge-agent-registry-test -- tsx test/agent-registry-test.ts",
    "test:device-info": "node scripts/run-env.mjs AGENT_BRIDGE_ROOT=/tmp/agent-bridge-device-info-test -- tsx test/device-info-test.ts",
    "test:local-fs": "node scripts/run-env.mjs AGENT_BRIDGE_ROOT=/tmp/agent-bridge-local-fs-test -- tsx test/local-fs-test.ts",
    "test:dashboard": "tsx test/dashboard-test.ts",
    "test:git-pr": "node scripts/run-env.mjs AGENT_BRIDGE_ROOT=/tmp/agent-bridge-git-pr-test -- tsx test/git-pr-test.ts",
    "test:session": "tsx test/session-test.ts",
    "test:agent-admin": "node scripts/run-env.mjs AGENT_BRIDGE_ROOT=/tmp/agent-bridge-admin-test -- tsx test/agent-admin-test.ts",
    "test:e2e-codex": "node scripts/run-env.mjs AGENT_BRIDGE_NOTIFY=0 -- tsx test/e2e-codex.ts",
    "test:e2e-codex-write": "node scripts/run-env.mjs AGENT_BRIDGE_NOTIFY=0 -- tsx test/e2e-codex-write.ts"
  },
  "keywords": [
    "mcp",
    "agent",
    "bridge",
    "modelcontextprotocol",
    "stdio"
  ],
  "author": "temiylin",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
